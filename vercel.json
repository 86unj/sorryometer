{
  "functions": {
    "api/confess.js": {
      "maxDuration": 90
    },
    "api/checkout.js": {
      "maxDuration": 30
    },
    "api/order.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/((?!api/|public/).*)", "destination": "/public/$1" }
  ]
}
